{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos de la ventana principal: comandos propios y abrir enlaces de Atlassian en el navegador.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*.atlassian.net/*" },
        { "url": "https://id.atlassian.com/*" }
      ]
    }
  ]
}
